# Root `.env.local` for the Next.js app (this repo). See docs/ENVIRONMENT.md.

# === Required (production intake) ===
#HUBSPOT_ACCESS_TOKEN=

# --- Test form + email without HubSpot (local / preview only) ---
#LEAD_INTAKE_BYPASS_HUBSPOT=true

# === Deal pipeline / stage (optional) ===
#HUBSPOT_PIPELINE_ID=
#HUBSPOT_DEAL_STAGE_ID=
#HUBSPOT_DEAL_OWNER_ID=

# LEAD_INTAKE_DEBUG=1
# HUBSPOT_PORTAL_ID=

# === Resend ===
# RESEND_API_KEY=
# INTERNAL_NOTIFY_EMAIL=ContactUs@CharltonBleecker.com
# Optional override for /api/contact (defaults to INTERNAL_NOTIFY_EMAIL)
# CONTACT_NOTIFY_EMAIL=

# NOTIFY_FROM_EMAIL=Deal Intake <noreply@mail.charltonbleecker.com>
# LEAD_INTAKE_SEND_SUBMITTER_EMAIL=false

# JSON response redirect after successful intake (Next app)
# THANK_YOU_REDIRECT=/thank-you

# Optional: cross-origin API base when the form is embedded elsewhere (legacy data-api-origin)
# NEXT_PUBLIC_LEAD_INTAKE_API_URL=https://www.charltonbleecker.com

# === HubSpot property toggles / renames ===
# HUBSPOT_USE_EXTENDED_COMPANY_PROPS=false
# HUBSPOT_USE_EXTENDED_CONTACT_PROPS=false
# HUBSPOT_USE_EXTENDED_DEAL_PROPS=false
# HUBSPOT_COMPANY_PROP_OWNERSHIP_STRUCTURE=ownership_structure
# HUBSPOT_COMPANY_PROP_FOUNDED_YEAR=founded_year
# HUBSPOT_COMPANY_PROP_NOTABLE_CUSTOMERS=notable_customers
# HUBSPOT_CONTACT_PROP_SUBMITTER_TYPE=submitter_type
# HUBSPOT_CONTACT_PROP_ADDITIONAL_NOTES=additional_notes

# CORS_ALLOW_ORIGIN=*

# === Site / sitemap (optional) ===
# SITE_URL=https://www.charltonbleecker.com

# === Introductory email utility (legacy; not used by new marketing pages) ===
# OUTREACH_UTILITY_SECRET=
# OUTREACH_FROM_EMAIL=
# OUTREACH_REPLY_TO=
# INTRO_EMAIL_CTA_URL=https://www.charltonbleecker.com/
# OUTREACH_LOGO_URL=
