# Place this file next to package.json (lead-intake-form-cbg/). If you run `npm run dev` from the repo root,
# vars are still loaded from this folder — not from the parent directory.

# === Required ===
# HubSpot Private App access token (scopes: crm.objects.contacts/companies/deals read/write, associations).
# If HubSpot returns 401 / "OAuth token expired", paste a fresh token from the Private App and redeploy Vercel.
#HUBSPOT_ACCESS_TOKEN=

# Local form testing without HubSpot (vercel dev / .env.local only — never in production).
# With bypass on, the API still parses the form and sends the team email via Resend when RESEND_API_KEY + INTERNAL_NOTIFY_EMAIL are set.
#LEAD_INTAKE_BYPASS_HUBSPOT=true

# === Deal pipeline / stage (optional) ===
# If HUBSPOT_PIPELINE_ID is unset or literally "default", the API resolves the first deal pipeline + stage from HubSpot (string "default" is not valid on the Deals API).
#HUBSPOT_PIPELINE_ID=
#HUBSPOT_DEAL_STAGE_ID=
# Optional: HubSpot user id to assign as owner (omit if unknown — a wrong id causes API errors)
#HUBSPOT_DEAL_OWNER_ID=

# LEAD_INTAKE_DEBUG=1 — include HubSpot error detail in 502 JSON on any Vercel env.
# On Vercel preview deployments, `hint` is included automatically (no env needed).

# HubSpot UI: Settings → Account Defaults → Hub ID (for team email links)
# HUBSPOT_PORTAL_ID=

# === Team email (n8n "Outlook - Notify Team") — Resend ===
# RECIPIENTS: comma-separated. FROM must use your verified Resend domain (e.g. mail.charltonbleecker.com).
# RESEND_API_KEY=
# INTERNAL_NOTIFY_EMAIL=ContactUs@CharltonBleecker.com, contact@example.com
# NOTIFY_FROM_EMAIL=Deal Intake <noreply@mail.charltonbleecker.com>

# Thank-you URL returned as JSON (n8n used: https://lead-intake-form-cbg.vercel.app/thank-you.html)
# THANK_YOU_REDIRECT=thank-you.html

# === Optional: disable custom HubSpot properties if your portal names differ ===
# HUBSPOT_USE_EXTENDED_COMPANY_PROPS=false
# HUBSPOT_USE_EXTENDED_CONTACT_PROPS=false
# HUBSPOT_USE_EXTENDED_DEAL_PROPS=false

# Property renames (defaults match exported n8n workflow)
# HUBSPOT_COMPANY_PROP_OWNERSHIP_STRUCTURE=ownership_structure
# HUBSPOT_COMPANY_PROP_FOUNDED_YEAR=founded_year
# HUBSPOT_COMPANY_PROP_NOTABLE_CUSTOMERS=notable_customers
# HUBSPOT_CONTACT_PROP_SUBMITTER_TYPE=submitter_type
# HUBSPOT_CONTACT_PROP_ADDITIONAL_NOTES=additional_notes

# CORS_ALLOW_ORIGIN=*
